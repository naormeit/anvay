# Copy to .env.local and fill in.
NEXT_PUBLIC_PRIVY_APP_ID=

# testnet or mainnet
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_ESCROW_ADDRESS=0x607B0075fd9602820AA9Ef4395D7b32657a10cDa
NEXT_PUBLIC_AUSD_ADDRESS=0x73E297c20cdee9291D09A66563C78939E5CA9aB5

# Server-only wallet that pays gas for claims (and runs the testnet faucet).
RELAYER_PRIVATE_KEY=

# Optional: custom RPC endpoint (defaults to the public Monad RPC)
NEXT_PUBLIC_RPC_URL=
